# بيانات محلية حساسة أو مؤقتة — لا تُرفَع لـ Git أبداً
.env

# ملفات عمل مؤقتة لسكربتات استيراد حزم الناشرين
docker/wp-cli-scripts/packs/_incoming/
docker/wp-cli-scripts/packs/_work/

# حزم الناشرين الفعلية نفسها (قد تحتوي عشرات ميغابايت من الصور) —
# تُدار كنسخ احتياطي منفصل، ليست جزءاً من كود المشروع نفسه.
# احذف هذا السطر لاحقاً إن أردت تتبعها ضمن Git أيضاً.
docker/wp-cli-scripts/packs/*.zip

# ملفات النظام
.DS_Store
Thumbs.db

# مجلدات عمل Claude المحلية إن وُجدت مصادفة
node_modules/
