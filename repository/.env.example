# انسخ هذا الملف إلى .env إذا أردت تغيير القيم الافتراضية.
# القيم الافتراضية في docker-compose.yml تعمل بلا الحاجة لهذا الملف إطلاقاً —
# هذا للتخصيص فقط (مثلاً لتغيير المنفذ إذا كان 8080 مستخدماً لديك).

MYSQL_DATABASE=maktaba
MYSQL_USER=maktaba
MYSQL_PASSWORD=maktaba_pass
MYSQL_ROOT_PASSWORD=root_pass

# منفذ الموقع على جهازك: http://localhost:8080
WORDPRESS_PORT=8080

# منفذ phpMyAdmin (لفحص الجداول): http://localhost:8081
PHPMYADMIN_PORT=8081
